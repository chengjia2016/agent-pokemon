[Unit]
Description=Agent Monster Judge Server
After=network.target postgresql.service

[Service]
Type=simple
User=postgres
WorkingDirectory=/opt/judge-server
ExecStart=/opt/judge-server/judge-server
Restart=on-failure
RestartSec=5
Environment=CONFIG_PATH=/opt/judge-server/.config/config.yaml

[Install]
WantedBy=multi-user.target
